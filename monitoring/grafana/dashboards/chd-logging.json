{
  "uid": "chd-logging",
  "title": "Logging — CHD vs Castle",
  "tags": ["chd", "logging"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "datasource": "Prometheus",
      "type": "stat",
      "id": 800,
      "title": "",
      "transparent": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "noValue": "Please wait",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": " ", "index": 0, "color": "transparent" },
                "1": { "text": "Please wait", "index": 1, "color": "#5794F2" }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }] },
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": { "valueSize": 14 }
      },
      "targets": [
        { "expr": "absent(chd_logging_calls_total) or vector(0)", "refId": "A", "instant": true }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 1,
      "title": "Logged calls per second",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (library, event) (rate(chd_logging_calls_total{status=\"success\"}[2m]))",
          "legendFormat": "{{event}} {{library}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "stat",
      "id": 2,
      "title": "p95 ratio (Castle / CHD)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chd_logging_call_duration_seconds_bucket{library=\"castle\",event=\"entry\"}[2m]))) / histogram_quantile(0.95, sum by (le) (rate(chd_logging_call_duration_seconds_bucket{library=\"chd\",event=\"entry\"}[2m])))",
          "legendFormat": "entry",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chd_logging_call_duration_seconds_bucket{library=\"castle\",event=\"exception\"}[2m]))) / histogram_quantile(0.95, sum by (le) (rate(chd_logging_call_duration_seconds_bucket{library=\"chd\",event=\"exception\"}[2m])))",
          "legendFormat": "exception",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 3,
      "title": "Call latency p50 / p95 / p99",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 1, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, library, event) (rate(chd_logging_call_duration_seconds_bucket[2m])))",
          "legendFormat": "p50 {{event}} {{library}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, library, event) (rate(chd_logging_call_duration_seconds_bucket[2m])))",
          "legendFormat": "p95 {{event}} {{library}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, library, event) (rate(chd_logging_call_duration_seconds_bucket[2m])))",
          "legendFormat": "p99 {{event}} {{library}}",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 4,
      "title": "Batch p95 (100 calls)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, library, event) (rate(chd_logging_batch_duration_seconds_bucket[2m])))",
          "legendFormat": "{{event}} {{library}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] }
}
