{
  "uid": "chd-coordination",
  "title": "Coordination suite",
  "tags": ["chd", "coordination"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "id": 10,
      "title": "Distributed lock",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 11,
      "title": "Lock operations per second",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(chd_lock_operations_total{status=\"success\"}[2m]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(rate(chd_lock_operations_total{status=\"failed\"}[2m]))", "legendFormat": "failed", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "stat",
      "id": 12,
      "title": "Lock p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(chd_lock_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "type": "row",
      "id": 20,
      "title": "Idempotency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 21,
      "title": "Idempotency operations per second",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(chd_idempotency_operations_total{status=\"success\"}[2m]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(rate(chd_idempotency_operations_total{status=\"failed\"}[2m]))", "legendFormat": "failed", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "stat",
      "id": 22,
      "title": "Idempotency p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(chd_idempotency_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "type": "row",
      "id": 30,
      "title": "Saga",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "datasource": "Prometheus",
      "type": "timeseries",
      "id": 31,
      "title": "Saga operations per second",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(chd_saga_operations_total{status=\"success\"}[2m]))", "legendFormat": "success", "refId": "A" },
        { "expr": "sum(rate(chd_saga_operations_total{status=\"failed\"}[2m]))", "legendFormat": "failed", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "type": "stat",
      "id": 32,
      "title": "Saga p95",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(chd_saga_duration_seconds_bucket[2m])))", "legendFormat": "p95", "refId": "A" }]
    }
  ]
}
